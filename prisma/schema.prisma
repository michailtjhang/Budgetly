generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Transaction {
  id          Int      @id @default(autoincrement())
  description String
  amount      Float
  type        String
  date        DateTime @default(now())
  userId      String
  account     String?
  category    String?  // NEW: Transaction Category
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
